# Telegram Bot Configuration
# Rename this file to .env and fill in your actual values

# Bot token from BotFather
BOT_TOKEN='your_bot_token_here'

# Website URL to be used as a Telegram Mini App
WEBSITE_URL=https://your-deployed-website.com

# Telegram Web App settings
WEB_APP_NAME='FoodCalc'
WEB_APP_DESCRIPTION='Calculate and track your daily food intake'